---
import Layout from '../layouts/Layout.astro';

const words = ['builders', 'data engineers', 'technologists', 'analytics leaders', 'AI enthusiasts'];
const email = 'hello@dataisland.co';
---

<Layout>
	<main class="flex justify-center px-6 lg:pr-[20vw]">
		<!-- One column shared by the title, sentence and email, so they all line up with the D.
		     Rows: flexible space / hero / flexible space with the email at the bottom,
		     which keeps the hero vertically centred.
		     On large screens the extra right padding on <main> shifts the column left of centre. -->
		<div class="hero grid min-h-svh w-fit grid-rows-[1fr_auto_1fr] text-6xl sm:text-8xl lg:text-[9rem]">
			<div class="row-start-2">
				<!-- Stacked title; tight line height keeps the two words together as one block -->
				<h1 class="font-bold leading-[0.95] tracking-tight">
					<span class="block">Data</span>
					<span class="block text-accent">Island</span>
				</h1>

				<!-- Optical nudge (in title-size em) so the text lines up with the D's stroke, not its box -->
				<div class="pl-[0.055em]">
					<p class="mt-8 text-base whitespace-nowrap text-accent sm:text-lg md:text-xl lg:text-2xl">
						We're a group of passionate{' '}
						<span id="rotator" class="rotator font-semibold text-ink" aria-hidden="true">
							{words.map((w, i) => <span class:list={['word', { 'is-active': i === 0 }]}>{w}</span>)}
						</span>
						<span class="sr-only">{words.slice(0, -1).join(', ')} and {words.at(-1)}</span>
					</p>
				</div>
			</div>

			<footer class="row-start-3 self-end pb-16 pl-[0.055em]">
				<a href={`mailto:${email}`} class="text-sm text-ink/60 hover:text-ink">{email}</a>
			</footer>
		</div>
	</main>
</Layout>

<style>
	/* All words sit in the same grid cell; only the active one is visible. */
	.rotator {
		display: inline-grid;
		/* clip-path (not overflow) keeps the word on the same baseline as the sentence */
		clip-path: inset(0);
	}

	.word {
		grid-area: 1 / 1;
		justify-self: start;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(100%);
		transition:
			transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
			opacity 0.5s ease;
	}

	.word.is-active {
		opacity: 1;
		transform: translateY(0);
	}

	.word.is-leaving {
		opacity: 0;
		transform: translateY(-100%);
	}

	/* On phones the sentence is too long for one line, so the word gets its own line */
	@media (max-width: 639px) {
		.rotator {
			display: grid;
			margin-top: 0.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.word {
			transition: none;
		}
	}
</style>

<script>
	const rotator = document.getElementById('rotator');
	const words = rotator ? Array.from(rotator.querySelectorAll<HTMLElement>('.word')) : [];

	if (rotator && words.length > 1) {
		let current = 0;

		setInterval(() => {
			const prev = words[current];
			prev.classList.replace('is-active', 'is-leaving');

			current = (current + 1) % words.length;
			const next = words[current];

			// Snap the incoming word back below the line without animating, then slide it up.
			next.style.transition = 'none';
			next.classList.remove('is-leaving');
			void next.offsetWidth;
			next.style.transition = '';
			next.classList.add('is-active');
		}, 2500);
	}
</script>
